NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here

# Supabase (required for new CRM + learning flow)
SUPABASE_URL=https://alikbjwnsporybnmmpcs.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Required for admin CRM and video management APIs
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Dev-only bootstrap token for /api/admin/init
ADMIN_INSTALL_TOKEN=set-a-different-long-random-string
# Initial admin credentials (created in Supabase Auth by /api/admin/init)
ADMIN_EMAIL=admin@mpu-focus.com
ADMIN_PASSWORD=secure-admin-password

# Authentication
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email
EMAIL_SERVER_USER=your-email@example.com
EMAIL_SERVER_PASSWORD=your-email-password
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=587
EMAIL_FROM=your-email@example.com

# UploadThing
UPLOADTHING_SECRET=your-uploadthing-secret
UPLOADTHING_APP_ID=your-uploadthing-app-id

# Mux (for video streaming)
MUX_TOKEN_ID=your-mux-token-id
MUX_TOKEN_SECRET=your-mux-token-secret
MUX_WEBHOOK_SECRET=your-mux-webhook-secret
MUX_SIGNING_KEY_ID=your-mux-signing-key-id
MUX_SIGNING_KEY_SECRET=your-mux-signing-private-key
MUX_UPLOAD_CORS_ORIGIN=http://localhost:3000

# Document Processing API
OPENAI_API_KEY=your-openai-api-key-here

# Optional /beratung Google Ads conversion tracking. Tag ID + each desired label; rebuild after changes.
# Loaded only after explicit advertising consent. No questionnaire/contact data is sent.
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=

# Website-only editor access (server-side allowlist; account must already exist)
WEBSITE_EDITOR_EMAILS=
# Protected contact destinations, E.164 including + (blank hides the button)
BERATUNG_PHONE=
BERATUNG_WHATSAPP=
# Separate secondary conversions for contact clicks
NEXT_PUBLIC_GOOGLE_ADS_PHONE_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_WHATSAPP_LABEL=
# Optional regional overrides; otherwise general labels above are used
NEXT_PUBLIC_GOOGLE_ADS_SOEST_FORM_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_SOEST_PHONE_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_SOEST_WHATSAPP_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_OLPE_FORM_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_OLPE_PHONE_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_OLPE_WHATSAPP_LABEL=
# Optional lead notification (uses existing SMTP_* and FROM_EMAIL settings)
# No recipient is assumed from the Kompakt brief.
LEAD_NOTIFICATION_EMAIL=
